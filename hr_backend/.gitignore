# Dependencies
node_modules/

# Environment variables — NEVER commit real secrets
.env

# Uploaded files — store in cloud (S3/GCS) in production
uploads/resumes/*
uploads/videos/*
# Keep the directories tracked but not their contents
!uploads/resumes/.gitkeep
!uploads/videos/.gitkeep

# Logs
logs/
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
